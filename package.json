{
  "name": "smartrelay",
  "version": "0.0.0",
  "private": true,
  "description": "SmartRelay.ro: event relay micro-SaaS (trigger, transform, relay) with pay-as-you-go credits.",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "pnpm --filter @smartrelay/db db:migrate",
    "db:seed": "pnpm --filter @smartrelay/db db:seed",
    "admin:credit": "pnpm --filter @smartrelay/scripts admin:credit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
