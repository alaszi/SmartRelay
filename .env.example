# Copy to .env and fill in. Never commit .env. All variables are validated at startup
# (packages/shared/src/env.ts); the process exits with a list of problems if any is wrong.

NODE_ENV=development

# Public origin of the web app and the domain used for inbound email addresses.
APP_URL=http://localhost:3000
INBOUND_DOMAIN=inbound.localhost
# Port the api process listens on (no reverse proxy in dev).
API_PORT=3001

# Dev services from docker-compose.yml
DATABASE_URL=postgres://smartrelay:smartrelay@localhost:5432/smartrelay
REDIS_URL=redis://localhost:6379

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SESSION_SECRET: any string of 32+ characters.
# ENCRYPTION_KEY: exactly 32 random bytes as base64 (44 characters). Losing or changing it makes
# stored secrets unreadable, so back it up and rotate only through the key-id mechanism.
SESSION_SECRET=
ENCRYPTION_KEY=
# Key rotation: give the new key a new id, and move the old key here as "id:base64key" (comma
# separated for several) so existing secrets stay readable until they are re-encrypted.
ENCRYPTION_KEY_ID=k1
ENCRYPTION_KEYS_PREVIOUS=

# Outbound email. Dev default: Mailpit from docker-compose.yml (UI at http://localhost:8025).
MAIL_FROM=SmartRelay <no-reply@smartrelay.localhost>
MAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
# MAIL_PROVIDER=postmark requires:
POSTMARK_SERVER_TOKEN=

# Inbound email (Module 2)
INBOUND_EMAIL_PROVIDER=postmark
INBOUND_EMAIL_SECRET=

# Payments and Google Calendar: optional in development, required when NODE_ENV=production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Feature flags and integrations
WHATSAPP_ENABLED=false
TRUST_CLOUDFLARE=false
SENTRY_DSN=
