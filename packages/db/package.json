{
  "name": "@smartrelay/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/cli/seed.ts"
  },
  "dependencies": {
    "@smartrelay/engine": "workspace:*",
    "@smartrelay/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.10"
  }
}
